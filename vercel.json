{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/cron/).*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "*/10 * * * *"
    }
  ]
}
